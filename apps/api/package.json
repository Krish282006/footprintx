{
  "name": "@footprintx/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:migrate:prod": "node dist/db/migrate-cli.js",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed-cli.ts",
    "jobs:notify": "tsx --env-file-if-exists=.env src/jobs/notify-cli.ts",
    "jobs:notify:prod": "node dist/jobs/notify-cli.js",
    "threat:sync": "tsx --env-file-if-exists=.env src/threat/sync-cli.ts",
    "threat:sync:prod": "node dist/threat/sync-cli.js",
    "links:verify": "tsx --env-file-if-exists=.env src/catalog/verify-links-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "tldts": "^7.4.18",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "smtp-server": "^3.19.21",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
