# ---------------------------------------------------------------------------
# FootprintX API configuration. Copy to apps/api/.env and fill in values.
# Never commit real secrets. Every variable here is documented in README.md.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (local Docker/Postgres or Neon in production).
# Neon example: postgres://USER:PASSWORD@ep-xxx.region.aws.neon.tech/footprintx?sslmode=require
DATABASE_URL=postgres://footprintx:footprintx_dev_password@localhost:5432/footprintx_dev
# Set to "true" for managed Postgres that requires TLS (Neon). Local: false.
DATABASE_SSL=false

# Public URL of the web frontend (used for CORS, links in emails, OAuth redirects).
WEB_ORIGIN=http://localhost:5173
# Comma-separated extra allowed origins for CORS (optional).
EXTRA_CORS_ORIGINS=
# Public base URL of this API (used to build OAuth redirect URIs).
API_PUBLIC_URL=http://localhost:4000

# Cookie settings. In production behind HTTPS set COOKIE_SECURE=true.
# If the frontend and API are on different sites (no Vercel rewrite), set COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168

# 32-byte key, base64 encoded, used for AES-256-GCM encryption of OAuth tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Trust the first proxy hop (Render, Vercel rewrite). Needed for correct client IPs.
TRUST_PROXY=false

# --- Email delivery (contact form, password reset, notifications) ---------
# EMAIL_PROVIDER: none | smtp | devlog
#   none   -> email features report "not configured" honestly
#   smtp   -> real delivery via SMTP (Brevo, Mailgun, Gmail SMTP, Mailpit, ...)
#   devlog -> DEVELOPMENT ONLY: messages are written to the dev outbox table and
#             server log; nothing is delivered. Refused when NODE_ENV=production.
EMAIL_PROVIDER=devlog
EMAIL_FROM="FootprintX <no-reply@footprintx.local>"
CONTACT_RECIPIENT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Email OAuth (account discovery) --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Maximum number of messages to inspect per mailbox scan (metadata only).
DISCOVERY_MAX_MESSAGES=500

# --- Breach catalogue (Have I Been Pwned public breach list, no key needed) --
BREACH_SOURCE=hibp
# Optional paid HIBP key enables per-email breach lookups. Leave blank to disable.
HIBP_API_KEY=

# --- Threat intelligence ---------------------------------------------------
# Comma-separated providers: feed, heuristics, urlhaus, safebrowsing, fixture
THREAT_PROVIDERS=feed,heuristics
# Comma-separated domain blocklist feed URLs (plain text, one domain per line).
THREAT_FEED_URLS=https://raw.githubusercontent.com/mitchellkrogza/Phishing.Database/master/phishing-domains-ACTIVE.txt
THREAT_FEED_MAX_AGE_HOURS=24
URLHAUS_AUTH_KEY=
GOOGLE_SAFE_BROWSING_KEY=
THREAT_LOOKUP_TIMEOUT_MS=4000

# --- Development switches (refused when NODE_ENV=production) ---------------
# Allows the clearly labelled "Development fixture mailbox" and dev fixtures.
ENABLE_DEV_FIXTURES=true
# Allows switching a user's plan to Premium for local demonstrations (no payment).
ENABLE_DEV_ENTITLEMENTS=true

LOG_LEVEL=info
